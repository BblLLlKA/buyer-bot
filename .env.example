# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# MongoDB (root-пользователь, задаётся при первом старте контейнера)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_generate_with_openssl_rand_base64_32
# MONGO_URI собирается автоматически в docker-compose.yml из переменных выше,
# отдельно задавать не нужно

# Redis (used for grammY sessions and BullMQ)
REDIS_PASSWORD=change_me_generate_with_openssl_rand_base64_32
# REDIS_URL тоже собирается в docker-compose.yml из REDIS_PASSWORD

# Comma-separated Telegram user IDs of primary admins.
# These are upserted into the DB as approved admins on every startup.
ADMIN_IDS=111111111,222222222

# Optional: log level (fatal|error|warn|info|debug|trace). Use `debug` to see
# full AIO/Namecheap request-response bodies and every conversation step; see
# README "Логирование" for how to read the output.
LOG_LEVEL=info

# AIO API (domain <-> campaign linking)
AIO_API_BASE_URL=https://app.aio.tech/api/v1
AIO_API_TOKEN=your_aio_jwt_token_here

# AIO API - domain purchase feature only (Domain\CreateManually action).
# Fixed identifiers from the working example request, not tied to a
# specific admin/buyer.
AIO_DNS_PROVIDER_UUID=your_aio_dns_provider_uuid
AIO_MONITORING_USER_UUID=your_aio_monitoring_user_uuid

# Namecheap API (domain purchase feature). See https://www.namecheap.com/support/api/intro/
NAMECHEAP_USERNAME=your_namecheap_username
NAMECHEAP_API_KEY=your_namecheap_api_key
NAMECHEAP_CLIENT_IP=your_whitelisted_client_ip

# Cloudflare API (domain purchase feature) — every purchased domain gets a
# Cloudflare zone created for it, and Namecheap's NS records are pointed at
# the nameservers Cloudflare assigns. Token needs Zone:Edit permission
# (account-scoped API token, not the legacy global API key) — no account ID
# is needed, the /zones endpoints used here are scoped by the token itself.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# Registrant/Tech/Admin/AuxBilling contact used for every domain purchased
# through the bot (Namecheap requires one on every registration).
NAMECHEAP_CONTACT_FIRST_NAME=
NAMECHEAP_CONTACT_LAST_NAME=
NAMECHEAP_CONTACT_ORGANIZATION=
NAMECHEAP_CONTACT_ADDRESS1=
NAMECHEAP_CONTACT_CITY=
NAMECHEAP_CONTACT_STATE=
NAMECHEAP_CONTACT_POSTAL_CODE=
NAMECHEAP_CONTACT_COUNTRY=
NAMECHEAP_CONTACT_PHONE=
NAMECHEAP_CONTACT_EMAIL=

# Domain purchase feature: upper limit per generate/manual request
MAX_DOMAINS_PER_REQUEST=25

# Domain purchase feature: estimated price per zone, used only to fail fast
# before attempting a purchase if the *Namecheap account's own balance* is
# clearly too low. The real balance and charge are Namecheap's — this bot
# does not track a separate balance per admin.
DOMAIN_PRICE_COM=12
DOMAIN_PRICE_INFO=5
DOMAIN_PRICE_ORG=14
DOMAIN_PRICE_DEFAULT=10

# Lander (whitepage) bulk-upload feature. Template/type UUIDs are fixed AIO
# identifiers for the Lander\Upload action — not tied to a specific
# admin/buyer, distinct from per-user UUIDs like aioUserUUID.
AIO_LANDER_TEMPLATE_UUID=your_aio_lander_template_uuid
AIO_LANDER_TYPE_UUID=your_aio_lander_type_uuid

# Base URL of the object storage AIO's multipart-upload flow writes
# completed archives to (used to build zip_url for Lander\Upload) — kept
# configurable since it's DigitalOcean Spaces today but could differ per AIO
# environment.
AIO_STORAGE_BASE_URL=https://aio-tech.ams3.digitaloceanspaces.com

# Lander bulk-upload feature: upper limit per upload session
MAX_LANDER_FILES=20

# Lander bulk-upload feature: max size per archive, in MB. NOTE — Telegram's
# Bot API only lets bots download files up to 20 MB regardless of this
# setting; see README "Массовая загрузка вайтов" before raising it above 20.
MAX_LANDER_FILE_SIZE_MB=25